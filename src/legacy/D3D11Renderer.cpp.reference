#ifdef _WIN32
#define WIN32_LEAN_AND_MEAN
#define NOMINMAX
#include "gz/D3D11Renderer.hpp"
#include "gz/Shaders.hpp"
#include <d3d11.h>
#include <d3dcompiler.h>
